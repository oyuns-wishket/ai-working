#!/usr/bin/env python3
"""Fake `codex exec` for tests. Same MSD_FAKE_ACTION contract as the fake claude."""
import json
import os
import subprocess
import sys
import time

args = sys.argv[1:]
prompt = sys.stdin.read() if args and args[-1] == "-" else ""
cwd = args[args.index("-C") + 1] if "-C" in args else os.getcwd()
os.chdir(cwd)
last_message = args[args.index("-o") + 1] if "-o" in args else None
thread_id = "fake-thread-" + str(os.getpid())
action = os.environ.get("MSD_FAKE_ACTION", "complete")
marker = os.environ.get("MSD_FAKE_MARKER", "lane.txt")
log = os.environ.get("MSD_FAKE_LOG")
if log:
    with open(log, "a", encoding="utf-8") as handle:
        handle.write(json.dumps({"argv": args, "cwd": os.getcwd(), "env_lane": os.environ.get("MULTI_SESSION_DEV_LANE"), "prompt_head": prompt[:80]}) + "\n")

print(json.dumps({"type": "thread.started", "thread_id": thread_id}), flush=True)
if action == "sleep":
    time.sleep(120)
if action == "fail":
    print(json.dumps({"type": "turn.failed", "error": {"message": "boom"}}))
    sys.exit(1)

result = {
    "status": "complete",
    "scope": "fake lane",
    "files": [],
    "evidence": [{"command": "true", "exit_code": 0, "summary": "ok"}],
    "risks": [],
    "handoff": "nothing",
    "verdict": "N/A",
    "blocked_reason": "",
}
if action in {"complete", "dirty"}:
    with open(marker, "a", encoding="utf-8") as handle:
        handle.write(f"{thread_id}\n")
    result["files"] = [marker]
    if action == "complete":
        subprocess.run(["git", "add", marker], check=True)
        subprocess.run(["git", "-c", "user.name=Fake", "-c", "user.email=fake@example.com", "commit", "-qm", f"fake lane {marker}"], check=True)
elif action == "blocked":
    result.update({"status": "blocked", "blocked_reason": "needs migration approval"})
elif action == "review-pass":
    result["verdict"] = "PASS"
elif action == "review-fail":
    result["verdict"] = "FAIL"

if last_message:
    with open(last_message, "w", encoding="utf-8") as handle:
        handle.write(json.dumps(result))
print(json.dumps({"type": "item.completed", "item": {"type": "agent_message", "text": json.dumps(result)}}))
print(json.dumps({"type": "turn.completed", "usage": {"input_tokens": 10, "output_tokens": 5}}))
