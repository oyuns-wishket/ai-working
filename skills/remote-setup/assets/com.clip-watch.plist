<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.clip-watch</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string><HOME>/.config/remote-clip/clip-watch.sh</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string><HOME>/.config/remote-clip/clip-watch.log</string>
  <key>StandardErrorPath</key><string><HOME>/.config/remote-clip/clip-watch.log</string>
</dict>
</plist>
